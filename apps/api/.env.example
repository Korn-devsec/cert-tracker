# ===== apps/api =====
# คัดลอกเป็น .env (ไฟล์ .env ถูก gitignore ไว้ — ห้าม commit)

NODE_ENV=development
PORT=3000

# origin ของ frontend สำหรับ CORS (คั่นหลายค่าด้วย comma ได้)
WEB_ORIGIN=http://localhost:5173

# PostgreSQL — host port ต้องตรงกับ POSTGRES_PORT ใน .env ที่ root (default 5433)
DATABASE_URL="postgresql://certtracker:certtracker@localhost:5433/cert_tracker?schema=public"

# ===== Seed (prisma db seed) =====
SEED_ADMIN_EMAIL=admin@example.com
# ถ้าไม่ตั้งค่า seed จะใช้รหัสผ่านชั่วคราวและเตือนใน log — ต้องเปลี่ยนก่อนใช้งานจริง
SEED_ADMIN_PASSWORD=ChangeMe!12345

# ===== Auth (Phase 2) =====
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# ===== Attachment (Phase 4) =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ===== Notification (Phase 5) =====
# true = โหมดซ้อม: ช่องทางเขียนลง log แทนการส่งจริง แต่ยังบันทึก NotificationLog ตามปกติ
# (ตั้ง false เมื่อพร้อมส่งจริง — ต้องกรอก SMTP / LINE ด้านล่างให้ครบก่อน)
NOTIFICATION_DRY_RUN=true

# ตารางเวลาสแกนรายวัน (รูปแบบ cron 5 ช่อง) — ค่าเริ่มต้น 08:00 ตามเวลาไทย
NOTIFICATION_CRON=0 8 * * *
NOTIFICATION_TIMEZONE=Asia/Bangkok
# false = ไม่ตั้งเวลาอัตโนมัติ (ยังสั่งด้วย POST /notifications/test-run ได้)
NOTIFICATION_CRON_ENABLED=true

# อีเมล: ผู้รับหลักคือ Company.contactEmail — ค่านี้ใช้เมื่อบริษัทยังไม่ได้กรอกอีเมล
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=cert-tracker@example.com
MAIL_TO_FALLBACK=

# LINE Messaging API: LINE_TO = userId/groupId ปลายทางของทีมที่ดูแล
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
