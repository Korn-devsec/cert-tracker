// Data Model ตาม CLAUDE.md
// Company → Site (optional) → Certificate → RenewalTask / HistoryLog / Attachment / NotificationLog
//
// สำคัญ: `daysUntilExpiry` และ `riskLevel` **ไม่เก็บเป็นคอลัมน์**
// เพราะเป็นค่าที่คำนวณจาก `expiresAt` ณ เวลา query ด้วย calculateRisk() ใน packages/shared
// (ถ้าเก็บไว้ ค่าจะค้างและเพี้ยนทันทีที่วันเปลี่ยน)
//
// enum ทุกตัวต้องมีค่าตรงกับ enum ใน packages/shared/src/enums.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Enums =====

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

/// workflow ที่คนอัปเดต — คนละเรื่องกับความเสี่ยง (กฎเหล็กข้อ 5)
enum WorkStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_VENDOR
  WAITING_CA
  TESTING
  COMPLETED
  CANCELLED
}

enum HistoryAction {
  IMPORT
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_DEACTIVATED
  SITE_CREATED
  SITE_UPDATED
  CERTIFICATE_CREATED
  CERTIFICATE_UPDATED
  TASK_CREATED
  ASSIGN
  STATUS_CHANGE
  CONTACT_VENDOR
  CSR_GENERATED
  CERTIFICATE_ISSUED
  INSTALL
  VERIFY
  COMPLETE
  CANCEL
  ATTACHMENT_UPLOADED
  NOTIFICATION_SENT
}

enum NotificationTier {
  DAY_90
  DAY_60
  DAY_30
  DAY_7
}

enum NotificationChannel {
  EMAIL
  LINE
}

enum ImportStatus {
  PENDING
  SUCCESS
  PARTIAL
  FAILED
}

// ===== Models =====

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         UserRole @default(VIEWER)
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedTasks RenewalTask[]

  @@index([role])
}

model Company {
  id           String   @id @default(uuid())
  name         String
  /// รหัสย่อบริษัท ใช้อ้างอิงตอนเลือกบริษัทก่อน import
  code         String   @unique
  contactEmail String?
  /// ปิดใช้งาน = soft delete (Phase 2) ไม่ลบข้อมูลจริงเพื่อคงประวัติ
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites         Site[]
  certificates  Certificate[]
  importBatches ImportBatch[]
  historyLogs   HistoryLog[]

  @@index([isActive])
}

/// ชั้นกลางแบบ optional — cert ผูกกับ company ได้โดยไม่ต้องมี site
model Site {
  id        String   @id @default(uuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Certificate {
  id                 String    @id @default(uuid())
  /// กฎเหล็กข้อ 4: ทุก certificate ต้องผูกกับบริษัท
  companyId          String
  siteId             String?
  commonName         String
  san                String[]  @default([])
  issuer             String?
  serialNumber       String?
  signatureAlgorithm String?
  keySize            Int?
  sha256Fingerprint  String?
  /// 1 endpoint ต่อ 1 record — เซลล์ Excel ที่มีหลาย endpoint จะถูก split ใน Phase 3
  /// ใช้ "" แทน null เพราะ PostgreSQL ถือว่า NULL แต่ละตัวไม่ซ้ำกัน
  /// ซึ่งจะทำให้ unique key ด้านล่าง (ที่ Phase 3 ใช้ upsert) ไม่ทำงาน
  endpoint           String    @default("")
  owner              String?
  remark             String?
  expiresAt          DateTime
  issuedAt           DateTime?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site             Site?             @relation(fields: [siteId], references: [id], onDelete: SetNull)
  renewalTasks     RenewalTask[]
  historyLogs      HistoryLog[]
  attachments      Attachment[]
  notificationLogs NotificationLog[]

  /// คีย์ที่ Phase 3 ใช้ตัดสินว่า import ซ้ำ → update ไม่ใช่ create
  @@unique([companyId, commonName, endpoint])
  @@index([companyId, expiresAt])
  @@index([expiresAt])
  @@index([siteId])
}

model RenewalTask {
  id            String     @id @default(uuid())
  certificateId String
  status        WorkStatus @default(NEW)
  assigneeId    String?
  dueDate       DateTime?
  note          String?
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  certificate Certificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  historyLogs HistoryLog[]

  @@index([certificateId, status])
  @@index([status])
  @@index([assigneeId])
}

/// กฎเหล็กข้อ 6: ทุก action สำคัญต้องลงประวัติ พร้อม actor / timestamp / detail
/// certificateId เป็น optional เพราะมี action ระดับระบบด้วย (เช่น สร้าง/แก้บริษัทใน Phase 2)
model HistoryLog {
  id            String        @id @default(uuid())
  action        HistoryAction
  /// เก็บชื่อ/อีเมลผู้ทำเป็น text เพื่อให้ประวัติยังอ่านได้แม้ user ถูกปิดใช้งานหรือลบ
  actor         String
  actorId       String?
  detail        String?
  /// ข้อมูลประกอบ เช่น { "from": "NEW", "to": "ASSIGNED" } หรือสรุปผล import
  metadata      Json?
  createdAt     DateTime      @default(now())
  certificateId String?
  companyId     String?
  renewalTaskId String?

  certificate Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  renewalTask RenewalTask? @relation(fields: [renewalTaskId], references: [id], onDelete: Cascade)

  @@index([certificateId, createdAt])
  @@index([companyId, createdAt])
  @@index([renewalTaskId])
  @@index([action, createdAt])
}

model Attachment {
  id            String   @id @default(uuid())
  certificateId String
  filename      String
  /// path ในที่เก็บไฟล์ (UPLOAD_DIR) — ไม่เก็บไฟล์ลง DB
  path          String
  mimeType      String?
  sizeBytes     Int?
  uploadedBy    String
  createdAt     DateTime @default(now())

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([certificateId])
}

/// ใช้กันการแจ้งเตือนซ้ำ (Phase 5 ต้อง idempotent)
model NotificationLog {
  id            String              @id @default(uuid())
  certificateId String
  channel       NotificationChannel
  tier          NotificationTier
  /// วันที่ส่ง (ตัดเวลาออก) — เป็นส่วนของ unique key เพื่อให้ tier <=7 วัน ส่งได้วันละ 1 ครั้ง
  /// ส่วน tier 90/60/30 ตรวจการมีอยู่ของ tier นั้นก่อนส่ง
  sentOn        DateTime            @db.Date
  sentAt        DateTime            @default(now())
  recipient     String?
  isSuccess     Boolean             @default(true)
  error         String?

  certificate Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@unique([certificateId, tier, channel, sentOn])
  @@index([certificateId, tier])
  @@index([sentAt])
}

model ImportBatch {
  id           String       @id @default(uuid())
  companyId    String
  filename     String
  sheetName    String?
  importedBy   String
  rowCount     Int          @default(0)
  createdCount Int          @default(0)
  updatedCount Int          @default(0)
  skippedCount Int          @default(0)
  status       ImportStatus @default(PENDING)
  /// รายการ error ที่ทำให้ reject (เช่น header ที่จำเป็นหาย) พร้อมเลขแถว
  errors       Json?
  /// warning ที่ import ผ่านได้ เช่น status ที่ map ไม่ได้
  warnings     Json?
  createdAt    DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([status])
}
