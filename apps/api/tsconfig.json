{
  "compilerOptions": {
    // nodenext แทน commonjs/node (=node10 ซึ่ง deprecated ใน TS 7)
    // apps/api ไม่มี "type": "module" ใน package.json → emit เป็น CommonJS ตามเดิม
    // และ resolve "exports" map ของ @cert-tracker/shared ไปที่ dist/cjs ได้ถูกต้อง
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
