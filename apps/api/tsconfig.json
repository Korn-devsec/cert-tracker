{
  "compilerOptions": {
    // nodenext แทน commonjs/node (=node10 ซึ่ง deprecated ใน TS 7)
    // apps/api ไม่มี "type": "module" ใน package.json → emit เป็น CommonJS ตามเดิม
    // และ resolve "exports" map ของ @cert-tracker/shared ไปที่ dist/cjs ได้ถูกต้อง
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    // ตั้งใจ "ไม่" เปิด incremental:
    // nest-cli ตั้ง deleteOutDir: true (ลบ dist ก่อน build) แต่ .tsbuildinfo อยู่นอก dist
    // จึงรอดจากการลบ แล้ว tsc คิดว่าไฟล์ที่ไม่ได้แก้ "emit ไปแล้ว" → ข้ามการเขียนไฟล์
    // ผลคือ dist ขาดไฟล์แบบเงียบๆ จน `npm run dev:api` พังด้วย MODULE_NOT_FOUND
    // (ย้าย buildinfo เข้า dist ก็ไม่นิ่ง เพราะชนกับจังหวะที่ deleteOutDir ลบโฟลเดอร์)
    // build เต็มใช้เวลาประมาณ 2 วินาที แลกกับความถูกต้องคุ้มกว่า
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true
  },
  "include": ["src", "test"],
  "exclude": ["node_modules", "dist"]
}
