{
  "name": "@cert-tracker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React frontend — SSL Certificate Lifecycle Management",
  "scripts": {
    "predev": "npm run build -w @cert-tracker/shared",
    "dev": "vite",
    "prebuild": "npm run build -w @cert-tracker/shared",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cert-tracker/shared": "*",
    "@tanstack/react-query": "^5.101.4",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
