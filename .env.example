# ค่าสำหรับ docker-compose (PostgreSQL container)
# คัดลอกไฟล์นี้เป็น .env ที่ root ของโปรเจกต์ก่อนรัน `docker compose up -d db`
POSTGRES_USER=certtracker
POSTGRES_PASSWORD=certtracker
POSTGRES_DB=cert_tracker

# host port ที่ map เข้า container (container ใช้ 5432 เสมอ)
# ใช้ 5433 เพราะเครื่อง dev อาจมี PostgreSQL local ครอง 5432 อยู่แล้ว
POSTGRES_PORT=5433

TZ=Asia/Bangkok
