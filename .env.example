# ค่าสำหรับ docker compose (ทั้ง db, api และ web)
# คัดลอกไฟล์นี้เป็น .env ที่ root ของโปรเจกต์ก่อนรัน `docker compose up -d --build`
#
# ค่าที่ "ต้องตั้งเอง" ก่อนใช้งานจริง: JWT_SECRET, SEED_ADMIN_PASSWORD, POSTGRES_PASSWORD

# ===== PostgreSQL =====
POSTGRES_USER=certtracker
POSTGRES_PASSWORD=certtracker
POSTGRES_DB=cert_tracker

# host port ที่ map เข้า container (container ใช้ 5432 เสมอ)
# ใช้ 5433 เพราะเครื่อง dev อาจมี PostgreSQL local ครอง 5432 อยู่แล้ว
POSTGRES_PORT=5433

TZ=Asia/Bangkok

# ===== พอร์ตที่เปิดให้เข้าถึง =====
# หน้าเว็บ (nginx) — เข้าใช้งานที่ http://localhost:8080
WEB_PORT=8080
# API (เปิดไว้เพื่อ debug — ผู้ใช้ทั่วไปเข้าผ่าน WEB_PORT)
API_PORT=3000

# ===== API =====
# origin ของหน้าเว็บสำหรับ CORS (production เสิร์ฟผ่าน nginx จึงเป็น same-origin)
WEB_ORIGIN=http://localhost:8080

# ต้องเปลี่ยนเป็นค่าสุ่มยาวๆ ก่อนใช้งานจริง (เช่น `openssl rand -base64 48`)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# บัญชีผู้ดูแลที่ถูกสร้างตอน seed (seed รันซ้ำได้ ไม่เขียนรหัสผ่านทับ)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!12345
# false = ไม่ต้อง seed ตอนสตาร์ท (ใช้เมื่อฐานข้อมูลมีข้อมูลจริงแล้ว)
RUN_SEED_ON_START=true

# ไฟล์แนบ
MAX_UPLOAD_SIZE_MB=10

# จำกัดจำนวนครั้งที่ลอง login ต่อ (IP + อีเมล) — ระดับ IP ทั้งหมดจำกัดที่ nginx อีกชั้น
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60

# ===== แจ้งเตือน =====
# true = โหมดซ้อม เขียนลง log แทนการส่งจริง (ค่าเริ่มต้น — ปลอดภัยกับการทดลองใช้)
NOTIFICATION_DRY_RUN=true
NOTIFICATION_CRON=0 8 * * *
NOTIFICATION_TIMEZONE=Asia/Bangkok
NOTIFICATION_CRON_ENABLED=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=cert-tracker@example.com
MAIL_TO_FALLBACK=

LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
